---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Player from "../components/Player.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.title,
  description = site.description,
} = Astro.props;

const fontHref =
  "https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/img/portrait.jpg", Astro.site).href;

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%2314110e'/%3E%3Ctext x='32' y='43' font-family='Georgia,serif' font-size='26' fill='%23f4f0e6' text-anchor='middle'%3ERO%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <script is:inline>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="bg-paper font-sans text-ink antialiased max-md:pb-20">
    <a
      href="#main"
      class="fixed top-0 left-[-9999px] z-[100] bg-ink px-4 py-3 text-paper focus:top-4 focus:left-4"
      >Skip to content</a
    >

    <Nav />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />
    <Player />
    <audio id="audio" preload="none"></audio>

    <script>
      import "../scripts/site";
    </script>
    <script>
      import "../scripts/qa";
    </script>
  </body>
</html>