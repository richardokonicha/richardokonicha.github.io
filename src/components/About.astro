---
import Dither from "./Dither.astro";
import SectionHead from "./SectionHead.astro";
import { facts, timeline } from "../data/site";
import { reveal, section } from "../styles/classes";
---

<section id="about" class:list={[section, "scroll-mt-20"]}>
  <div
    class="wrap grid grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] items-start gap-[clamp(2rem,6vw,6rem)] max-tb:grid-cols-1 max-tb:gap-[3rem]"
  >
    <div
      class="sticky top-[calc(var(--spacing-nav)_+_2rem)] max-tb:static max-tb:max-w-[320px]"
    >
      <div class={reveal}>
        <Dither
          src="/img/portrait.jpg"
          alt="Portrait of Richard Okonicha"
          width={760}
          height={760}
          size="md"
          contrast={140}
          opacity={0.5}
          hover={0.28}
          class="w-full max-w-[360px]"
        />
        <p
          class="mt-[0.7rem] font-mono text-[0.62rem] tracking-[0.08em] text-muted uppercase"
        >
          Lagos, Nigeria · 6°27′N 3°23′E
        </p>
      </div>
    </div>

    <div class="max-tb:max-w-[640px]">
      <SectionHead no="04" title="About" class="mb-[2rem]" />

      <p
        class:list={[
          "mb-[1.5rem] max-w-[58ch] font-serif text-[clamp(1.6rem,3vw,2.3rem)] leading-[1.18] tracking-[-0.015em] text-muted",
          reveal,
        ]}
      >
        I build infrastructure that other people build on — health data systems,
        developer platforms, AI clouds.
      </p>

      <p class:list={["mb-[1rem] max-w-[58ch] text-muted", reveal]}>
        My work sits between distributed systems and the people who use them. I've led
        teams, designed APIs, chased race conditions, and spent a lot of time making
        complex things feel simple.
      </p>

      <p class:list={["mb-[1rem] max-w-[58ch] text-muted", reveal]}>
        Outside of work: photography, typography, long walks, and the occasional
        generative sketch.
      </p>

      <ol
        class:list={[
          "mt-[2.5rem] m-0 list-none border-t border-rule p-0",
          reveal,
        ]}
      >
        {
          timeline.map((entry) => (
            <li class="grid grid-cols-[90px_1fr] gap-[1.25rem] border-b border-rule py-[0.7rem] text-[0.9rem]">
              <span class="pt-[0.15rem] font-mono text-[0.66rem] tracking-[0.04em] text-muted">
                {entry.period}
              </span>
              {entry.role}
            </li>
          ))
        }
      </ol>

      <dl
        class:list={[
          "mt-[2.25rem] grid grid-cols-2 gap-x-[2rem] gap-y-[1rem] max-tb:grid-cols-1",
          reveal,
        ]}
      >
        {
          facts.map((fact) => (
            <div class="border-t border-rule pt-[0.6rem]">
              <dt class="font-mono text-[0.62rem] tracking-[0.08em] text-muted uppercase">
                {fact.term}
              </dt>
              <dd class="mt-[0.2rem] text-[0.88rem]">{fact.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>