---
import Dither from "./Dither.astro";
import { reveal } from "../styles/classes";
---

<section
  id="top"
  class="flex min-h-svh items-center pt-[calc(var(--spacing-nav)_+_clamp(3rem,8vh,6rem))] pb-[clamp(3rem,8vh,6rem)] max-tb:min-h-0 max-tb:pt-32"
>
  <div
    class="wrap grid grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] items-center gap-[clamp(2rem,6vw,6rem)] max-tb:grid-cols-1 max-tb:gap-[3rem]"
  >
    <div class="hero-copy">
      <p
        class:list={[
          "mb-[clamp(1.5rem,4vh,2.5rem)] font-mono text-[0.7rem] tracking-[0.18em] text-muted uppercase",
          reveal,
        ]}
      >
        Lagos, Nigeria — Independent builder
      </p>

      <h1
        data-pretext-lines
        class="font-serif text-[clamp(3.4rem,9.6vw,9rem)] leading-[0.9] tracking-[-0.03em] -ml-[0.04em]"
        >Richard Okonicha</h1
      >

      <p
        data-pretext-lines
        class="mt-[clamp(1.75rem,4vh,2.75rem)] max-w-[46ch] text-[clamp(1rem,1.35vw,1.12rem)] leading-[1.6] text-muted"
      >
        Software engineer, systems architect and independent builder. I work across
        software engineering, artificial intelligence, cloud infrastructure and
        distributed systems.
      </p>

      <p
        class:list={[
          "mt-[1.1rem] max-w-[42ch] font-serif text-[clamp(1.15rem,1.8vw,1.4rem)] leading-[1.35]",
          reveal,
        ]}
      >
        I enjoy building things, exploring ideas and understanding how complex
        systems work.
      </p>

      <div
        class:list={[
          "mt-[clamp(2rem,5vh,3.5rem)] flex flex-wrap items-center gap-x-[2rem] gap-y-[1rem]",
          reveal,
        ]}
      >
        <a
          href="#work"
          class="group inline-flex items-center gap-[0.7rem] font-mono text-[0.68rem] tracking-[0.14em] text-muted uppercase transition-colors duration-200 hover:text-ink"
        >
          <span>Selected work</span>
          <span
            aria-hidden="true"
            class="transition-transform duration-[250ms] group-hover:translate-y-[3px]"
            >↓</span
          >
        </a>
        <span
          class="inline-flex items-center gap-[0.55rem] font-mono text-[0.66rem] tracking-[0.08em] text-muted"
        >
          <span class="size-[6px] rounded-full bg-accent animate-dot"></span>
          Currently building Fugoku Cloud
        </span>
      </div>
    </div>

    <figure
      class:list={[
        "w-[min(100%,380px)] justify-self-end max-tb:w-[min(100%,320px)] max-tb:justify-self-start",
        reveal,
      ]}
    >
      <Dither
        src="/img/portrait.jpg"
        alt="Portrait of Richard Okonicha"
        width={760}
        height={760}
        size="md"
        contrast={132}
        brightness={1.02}
        opacity={0.55}
        hover={0.3}
        eager
        class="w-full"
      />
      <figcaption
        class="mt-[0.7rem] flex justify-between gap-[1rem] font-mono text-[0.64rem] tracking-[0.08em] text-muted uppercase"
      >
        <span>Richard Okonicha, Lagos</span>
        <span>2026</span>
      </figcaption>
    </figure>
  </div>
</section>